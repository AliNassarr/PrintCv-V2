# ==============================================================================
# PRINTCV ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local dev, and add the same keys in
# Vercel > Project > Settings > Environment Variables for production.
# ==============================================================================

# Public URL of the app, with https:// (no trailing slash).
# Local dev: http://localhost:3000   Production: https://printcv.me
# Login always runs on this address, so users on www. or preview URLs are sent here first.
APP_URL="http://localhost:3000"

# Signs the login cookie. At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# 42 Intra OAuth app: https://profile.intra.42.fr/oauth/applications
# Redirect URI must be: <APP_URL>/api/auth/callback/42-school
# Scope: public
FORTY_TWO_CLIENT_ID=""
FORTY_TWO_CLIENT_SECRET=""

# Optional: the login relay in relay/cloudflare-worker.js, for hosts that 42 blocks (like Vercel).
# Must be an https:// server YOU own: it holds the client secret and sees login codes.
# Leave both empty to talk to 42 directly (works on your own computer).
# With both set, 42 sends students to <FORTY_TWO_API_BASE>/callback, so add that redirect URI
# in your 42 app. RELAY_SECRET is 32+ random characters, the same value as on the relay.
FORTY_TWO_API_BASE=""
RELAY_SECRET=""
